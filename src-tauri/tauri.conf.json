{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nostak",
  "version": "0.1.3",
  "identifier": "com.nostak.app",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build:css"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Nostak - Navegando pelo Foco Profundo",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self' data:; connect-src 'none';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/nostak/nostak-helper": "../debian/polkit/nostak-helper",
          "/usr/share/polkit-1/actions/com.nostak.hosts.policy": "../debian/polkit/com.nostak.hosts.policy"
        }
      },
      "rpm": {
        "files": {
          "/usr/lib/nostak/nostak-helper": "../debian/polkit/nostak-helper",
          "/usr/share/polkit-1/actions/com.nostak.hosts.policy": "../debian/polkit/com.nostak.hosts.policy"
        }
      }
    }
  }
}